{
  "name": "picozip",
  "version": "0.0.1-beta.1",
  "description": "A truly cross platform zip library designed for memory limited environment, fully written in JS using modern standard JS APIs.",
  "homepage": "https://github.com/limzykenneth/picozip#readme",
  "bugs": {
    "url": "https://github.com/limzykenneth/picozip/issues"
  },
  "license": "MIT",
  "author": "Kenneth Lim <hello@limzykenneth.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limzykenneth/picozip.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./fetcher/cf-workers/r2": "./dist/fetcher/cf-workers/r2.mjs",
    "./fetcher/fetch": "./dist/fetcher/fetch/index.mjs",
    "./fetcher/node/fs": "./dist/fetcher/node/fs.mjs",
    "./fetcher/s3": "./dist/fetcher/s3/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@msw/cloudflare": "^0.2.0",
    "@playwright/browser-chromium": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "msw": "^3.0.3",
    "typescript": "^7.0.2",
    "vite-plugin-arraybuffer": "^0.1.4",
    "vite-plus": "^1.2.0"
  },
  "optionalDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "download"
    }
  },
  "allowScripts": {
    "@playwright/browser-chromium@1.64.1": true
  }
}
